rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Admins can read/write everything safely
    match /{document=**} {
      allow read, write: if request.auth != null; // Authenticated users (like Shop Admin or Logged Customers)
    }

    // Publicly readable shop pricing and data
    match /shops/{shopId} {
      allow read: if true;
      allow write: if request.auth != null;
      
      // Customers can create jobs without being logged in (Guest Checkout)
      // If we force login, we can change this to request.auth != null
      match /jobs/{jobId} {
        allow read, write: if true; // Allows guests to create queue jobs
      }
    }

    // Users collection for storing profile (Name, Phone)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
